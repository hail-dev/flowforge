# syntax=docker/dockerfile:1
# One image that runs the API and the worker together, for hosts with a single free service.
# Build from the repo root:  docker build -f deploy/Dockerfile.combined -t flowforge-combined:local .

FROM node:24-bookworm-slim AS base
WORKDIR /app

FROM base AS toolchain
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

FROM toolchain AS manifests
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/package.json
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json

FROM manifests AS build
RUN npm ci --workspace=@flowforge/core --workspace=@flowforge/api --workspace=@flowforge/worker
COPY packages/core packages/core
COPY apps/api apps/api
COPY apps/worker apps/worker
RUN npm run build -w @flowforge/api && npm run build -w @flowforge/worker

FROM manifests AS prod-deps
RUN npm ci --omit=dev --workspace=@flowforge/core --workspace=@flowforge/api --workspace=@flowforge/worker

FROM base AS runtime
ENV NODE_ENV=production
COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build /app/packages/core/package.json ./packages/core/package.json
COPY --from=build /app/packages/core/dist ./packages/core/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build /app/apps/worker/dist ./apps/worker/dist
COPY deploy/start.js ./start.js
USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_PORT||process.env.PORT||3001)+'/livez').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "start.js"]