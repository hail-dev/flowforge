{
    "name": "@flowforge/core",
    "version": "0.1.0",
    "private": true,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./dsl": {
            "types": "./dist/dsl/index.d.ts",
            "default": "./dist/dsl/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "dev": "tsc -p tsconfig.build.json --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "bullmq": "^6.7.6",
        "cron-parser": "^5.10.4",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "undici": "^8.12.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/pg": "^8.23.1",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
