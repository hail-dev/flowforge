# Postgres (used by docker-compose)
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge_dev_password
POSTGRES_DB=flowforge
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=3001

# Connection strings for app code on your host machine
DATABASE_URL=postgresql://flowforge:flowforge_dev_password@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379

JWT_SECRET=dev_only_change_me_123
NODE_ENV=development

EXECUTION_TIMEOUT_MS=60000

LOG_LEVEL=info

# Dev only: lets HTTP actions call localhost/private addresses (needed for /dev/echo). Must be false in production.
ALLOW_PRIVATE_NETWORKS=true

# Number of reverse proxies in front of the API: 0 locally, 1 on Render. A wrong value breaks per-IP rate limits.
TRUST_PROXY_HOPS=0