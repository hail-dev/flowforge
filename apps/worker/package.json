{
    "name": "@flowforge/worker",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/index.ts",
        "build": "tsc",
        "start": "node --env-file=../../.env dist/index.js",
        "typecheck": "tsc --noEmit",
        "dev:once": "tsx --env-file=../../.env src/index.ts",
        "predev": "tsc -p ../../packages/core/tsconfig.build.json",
        "predev:once": "tsc -p ../../packages/core/tsconfig.build.json",
        "pretypecheck": "tsc -p ../../packages/core/tsconfig.build.json",
        "prebuild": "tsc -p ../../packages/core/tsconfig.build.json"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "@types/pg": "^8.23.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "pino": "^10.4.0",
        "@flowforge/core": "*"
    }
}
