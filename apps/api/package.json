{
    "name": "@flowforge/api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch --env-file=../../.env src/index.ts",
        "build": "tsc",
        "start": "node --env-file=../../.env dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "migrate:up": "node-pg-migrate up -m migrations --envPath ../../.env",
        "migrate:down": "node-pg-migrate down -m migrations --envPath ../../.env",
        "migrate:create": "node-pg-migrate create -m migrations"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "bullmq": "^6.3.11",
        "express": "^5.2.1",
        "ioredis": "^6.0.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.23.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.6.3",
        "@types/pg": "^8.23.1",
        "dotenv": "^18.0.5",
        "node-pg-migrate": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    }
}
